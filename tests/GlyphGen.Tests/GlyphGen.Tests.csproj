<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Double '-' in commands below

    Dependency-free test project: no xUnit/NUnit packages, so it restores and runs anywhere.
      dotnet run -project tests/GlyphGen.Tests            run everything
      dotnet run -project tests/GlyphGen.Tests - Spacing  only tests whose name contains "Spacing"
      dotnet run -project tests/GlyphGen.Tests - -list   list the tests
    Exit code 0 = all passed, 1 = something failed (so it works in CI as is).
    Adjust the target framework and the two project paths below to match your solution.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\GlyphGen.Core\GlyphGen.Core.csproj" />
    <ProjectReference Include="..\..\GlyphGen.Rendering\GlyphGen.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestConfigs\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
