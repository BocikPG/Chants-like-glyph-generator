{
  "rootSeed": 1234,
  "outputDirectory": "./output-test",
  "languages": [
    {
      "name": "Base",
      "grid": { "width": 15, "height": 15 },
      "canvas": { "sizePx": 512, "marginPx": 32 },
      "glyphs": [ "a", "b", "c", "ab" ],
      "subSymbolCount": { "min": 1, "max": 2 },
      "subSymbolLength": { "min": 4, "max": 6 },
      "connectionRules": [
        { "direction": "Orthogonal", "minLength": 1, "maxLength": 3, "weight": 3.0 },
        { "direction": "Diagonal", "minLength": 1, "maxLength": 2, "weight": 1.0 }
      ],
      "allowNodeRevisit": false,
      "allowEdgeRevisit": false,
      "allowClosedLoop": false,
      "closedLoopWeight": 0.0,
      "allowSymbolsToCross": true,
      "guaranteedMotifs": [],
      "subSymbolPlacement": { "mode": "RandomValid", "allowRotationOnPlace": true, "maxPlacementAttempts": 40 },
      "subSymbolSpacing": { "enabled": false },
      "usageSizeBias": { "strength": 0 },
      "quality": { "maxSimilarity": 1.0, "rejectStraightLineOnly": false, "maxRegenerationAttempts": 5 },
      "combination": {
        "recipes": { "ab": [ "a", "b" ] },
        "allowScale": false,
        "allowedScales": [],
        "allowRotate": false,
        "rotation": { "allowed": [ 0 ], "weight": 1.0 },
        "maxRetriesPerRecipe": 5,
        "bias": { "modes": [] }
      },
      "curve": {
        "mode": "Derived",
        "contextMode": "AllCurved",
        "straightLineBias": { "min": 0, "max": 0 },
        "tension": { "options": [ { "min": 0.3, "max": 0.4, "weight": 1 } ] },
        "explicitJitterDegrees": { "min": 20, "max": 20 },
        "proximityGuard": { "enabled": false }
      },
      "render": {
        "framing": "Language",
        "foreground": "#FFFFFFFF",
        "background": "#00000000",
        "typeface": {
          "kind": "Rectangular",
          "rectangular": { "width": { "min": 0.04, "max": 0.04 }, "join": "Miter", "cap": "Butt", "miterLimit": 4.0 }
        }
      }
    }
  ]
}
