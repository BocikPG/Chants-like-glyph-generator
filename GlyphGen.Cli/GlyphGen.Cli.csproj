<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Generation is a short, compute-heavy run: compile everything fully optimized at once instead of tiering up (about 40% faster here). -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlyphGen.Core\GlyphGen.Core.csproj" />
    <ProjectReference Include="..\GlyphGen.Rendering\GlyphGen.Rendering.csproj" />
  </ItemGroup>

</Project>
